<?xml version="1.0" encoding="utf-8"?>
<GameSettings>
    <System>
        <TextureAtlases>
            <TextureAtlas pathToDefinitionFile="images/gems.xml"/>
            <TextureAtlas pathToDefinitionFile="images/logo.xml"/>
        </TextureAtlases>
    </System>
    <Board width="8" height="8">
        <GeneratorPool>
            <Tile type="Simple1"/>
            <Tile type="Simple2"/>
            <Tile type="Simple3"/>
            <Tile type="Simple4"/>
            <Tile type="Simple5"/>
        </GeneratorPool>
        <Timings
                delayBeforeFallIntoFreeCell="0.1"
                fallDownDuration="0.2"
        />
    </Board>
    <View cellSize="128">
        <MainMenu logoSpriteId="logo"/>
        <Tiles>
            <Tile type="Simple1" spriteId="gem1"/>
            <Tile type="Simple2" spriteId="gem2"/>
            <Tile type="Simple3" spriteId="gem4"/>
            <Tile type="Simple4" spriteId="gem5"/>
            <Tile type="Simple5" spriteId="gem6"/>
        </Tiles>
    </View>
</GameSettings>
